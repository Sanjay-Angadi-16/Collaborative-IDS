import hashlib

with open(
    "results/phase13/feature_search/phase13_selected_mask.npy",
    "rb",
) as f:
    mask_hash = hashlib.sha256(
        f.read()
    ).hexdigest()

print(
    "Frozen Phase13A mask SHA256:",
    mask_hash,
)
